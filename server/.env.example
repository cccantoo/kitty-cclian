# Kitty 账本 API 环境变量（复制为 .env 后按需修改；Node 侧用 process.env 读取）
# 也可由 systemd/环境直接注入，无需 .env 文件（本工程不引入 dotenv，靠外部环境）

# --- MySQL（生产建议只允许 127.0.0.1 访问） ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=你的数据库密码
DB_NAME=kitty_db

# --- HTTP ---
PORT=8300
# 仅监听本机（nginx 反代）；本地联调可改 0.0.0.0
BIND_HOST=127.0.0.1

# --- 鉴权 ---
TOKEN_TTL_DAYS=90
# 登录限流：窗口分钟 / 窗口内最大失败次数
RATE_WINDOW_MIN=15
RATE_MAX_FAILS=5

# --- CORS（本地开发前端跨端口调试时才需要；生产同源走 nginx 可留空）---
# 多个源用逗号分隔，如 http://localhost:8444
CORS_ORIGIN=
